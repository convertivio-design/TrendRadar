# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
venv/
.venv/
env/
.env.local

# IDE settings
.vscode/
.idea/
*.swp
*.swo
*~

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Unit test / coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

# Documentation
docs/_build/

# OS files
.DS_Store
Thumbs.db

# Local output data (keep example files)
output/*
!output/.gitkeep

# Credentials and secrets (never commit these!)
*.pem
*.key
credentials.json
secrets.json
.env.secrets

# Logs
*.log
logs/

# SQLite databases
*.db
*.sqlite
*.sqlite3
